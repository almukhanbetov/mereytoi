{{define "transactional_content"}}<h2 style="margin:0 0 16px;font-size:19px;color:#f3e6c8;">{{.Heading}}</h2>
{{range .Paragraphs}}<p style="margin:0 0 14px;">{{.}}</p>
{{end}}{{if .FactRows}}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:18px 0;background:#221d1a;border-radius:8px;">
{{range .FactRows}}<tr>
  <td style="padding:9px 14px;color:#a89f96;font-size:13px;width:40%;border-bottom:1px solid #2c2622;">{{.Label}}</td>
  <td style="padding:9px 14px;color:#ececec;font-size:13px;border-bottom:1px solid #2c2622;">{{.Value}}</td>
</tr>
{{end}}</table>
{{end}}{{if .CTAURL}}{{template "cta_button" .}}{{end}}{{end}}
