{{define "layout"}}<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>MEREYTOI</title>
</head>
<body style="margin:0;padding:0;background:#0f0d0c;font-family:Arial,Helvetica,sans-serif;">
  <span style="display:none;max-height:0;overflow:hidden;opacity:0;">{{.Preheader}}</span>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#0f0d0c;padding:32px 16px;">
    <tr><td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#1a1614;border-radius:12px;overflow:hidden;border:1px solid #2c2622;">
        <tr>
          <td style="padding:26px 32px;border-bottom:1px solid #2c2622;">
            <span style="font-size:20px;font-weight:700;color:#d4af6a;letter-spacing:1px;">MEREYTOI</span>
          </td>
        </tr>
        <tr>
          <td style="padding:30px 32px;color:#ececec;font-size:15px;line-height:1.65;">
            {{.Content}}
          </td>
        </tr>
        <tr>
          <td style="padding:18px 32px;border-top:1px solid #2c2622;color:#8b8580;font-size:12px;">
            MEREYTOI &middot; mereytoi.kz
          </td>
        </tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
{{end}}

{{define "cta_button"}}<p style="text-align:center;margin:28px 0;">
  <a href="{{.CTAURL}}" style="display:inline-block;background:#d4af6a;color:#1a1614;font-weight:700;font-size:14px;text-decoration:none;padding:13px 28px;border-radius:8px;">{{.CTAText}}</a>
</p>
{{end}}
