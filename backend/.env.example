PORT=8090

DB_HOST=localhost
DB_PORT=5433
DB_USER=mereytoi
DB_PASSWORD=mereytoi_password
DB_NAME=mereytoi_db
DB_SSLMODE=disable

JWT_SECRET=change-me-in-production

CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Used to build links inside transactional emails (invite links, request-tab
# links, admin review links) — should be the frontend's real public origin.
FRONTEND_URL=http://localhost:3000

# Stage 11A — transactional email (see backend/internal/mail).
#
# MAIL_ENABLED=false (the default) means every business action that would
# send an email still succeeds exactly as before; the send is just skipped
# and logged. This is deliberately off out of the box so a fresh clone or
# CI run never attempts a real SMTP connection nobody configured.
#
# Local dev: run `docker compose up -d mailpit` (see docker-compose.yml),
# set MAIL_ENABLED=true, leave MAIL_HOST/PORT as below, and open
# http://localhost:8025 to see mail arrive — nothing is ever sent to a real
# inbox in development.
#
# Production: point these at your real SMTP provider/relay. Never commit
# real values here.
MAIL_ENABLED=false
MAIL_DRIVER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@mereytoi.kz
MAIL_FROM_NAME=MEREYTOI
MAIL_USE_TLS=false
