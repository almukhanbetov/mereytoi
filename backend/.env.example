PORT=8090

DB_HOST=localhost
DB_PORT=5433
DB_USER=mereytoi
DB_PASSWORD=mereytoi_password
DB_NAME=mereytoi_db
DB_SSLMODE=disable

JWT_SECRET=change-me-in-production

CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Used to build links inside transactional emails (invite links, request-tab
# links, admin review links) — should be the frontend's real public origin.
FRONTEND_URL=http://localhost:3000

# Stage 11A — transactional email (see backend/internal/mail).
#
# MAIL_ENABLED=false (the default) means every business action that would
# send an email still succeeds exactly as before; the send is just skipped
# and logged. This is deliberately off out of the box so a fresh clone or
# CI run never attempts a real SMTP connection nobody configured.
#
# Local dev: run `docker compose up -d mailpit` (see docker-compose.yml),
# set MAIL_ENABLED=true, leave MAIL_HOST/PORT as below, and open
# http://localhost:8025 to see mail arrive — nothing is ever sent to a real
# inbox in development.
#
# Production: point these at your real SMTP provider/relay. Never commit
# real values here.
MAIL_ENABLED=false
MAIL_DRIVER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@mereytoi.kz
MAIL_FROM_NAME=MEREYTOI
MAIL_USE_TLS=false

# Booking->account onboarding (see backend/internal/handlers/onboarding.go).
# false (the default) means a guest booking behaves exactly as it always
# has — no pending account, no draft event, no claim link.
AUTO_ACCOUNT_FROM_BOOKING=false

# Claim-link delivery over messengers (see backend/internal/claimdelivery,
# internal/whatsapp, internal/telegram). SMS was this pipeline's first
# iteration and has been fully removed — no SMS_* var is read anywhere in
# this codebase any more.
#
# CLAIM_DELIVERY_ENABLED=false (the default) means a fresh clone/CI run
# never attempts a real WhatsApp/Telegram API call — the claim link still
# works via the in-page "Открыть мой той" button either way (brief section
# 13 — external delivery is a convenience, never a requirement for access).
CLAIM_DELIVERY_ENABLED=false
CLAIM_DELIVERY_PRIMARY=whatsapp

# WhatsApp — Meta's own WhatsApp Cloud API only (no BSP — Twilio/Infobip/
# etc. — integration exists in this codebase). Leave WHATSAPP_ACCESS_TOKEN
# or WHATSAPP_PHONE_NUMBER_ID empty and WhatsApp is treated as unavailable
# (claimdelivery falls through to Telegram, or to no external delivery at
# all) rather than silently failing. WHATSAPP_TEMPLATE_NAME empty means
# plain-text messages, which Meta only actually delivers within an existing
# 24h customer-service window — for real cold-start delivery you need an
# approved template (see internal/whatsapp's own doc comment) and must set
# this to that template's name.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=ru

# Telegram — TELEGRAM_BOT_USERNAME is only needed to build the
# `https://t.me/<username>?start=<token>` linking link (can be set before
# the bot token is); TELEGRAM_BOT_TOKEN is required for both linking's
# confirmation message and actual claim-link delivery.
# TELEGRAM_WEBHOOK_SECRET is optional — if set, incoming webhook calls
# missing the matching X-Telegram-Bot-Api-Secret-Token header are rejected
# (see Telegram's own setWebhook `secret_token` parameter).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
